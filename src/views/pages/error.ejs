<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · CTENT</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/app.css?v=<%= typeof assetV !== 'undefined' ? assetV : 1 %>">
<script src="/static/js/theme.js?v=<%= typeof assetV !== 'undefined' ? assetV : 1 %>"></script>
</head>
<body>
<main class="auth">
  <div class="auth-card" style="text-align:center;align-items:center">
    <span style="font:700 48px var(--font);letter-spacing:-.03em;color:var(--pri-text)"><%= code %></span>
    <h1><%= title %></h1>
    <p class="text-2"><%= message %></p>
    <div class="split" style="justify-content:center"><a class="btn btn-p" href="/">Go to dashboard</a><a class="btn btn-s" href="/topics">Your topics</a></div>
  </div>
</main>
</body>
</html>
