<%- include('../partials/top') %>
<%- include('../partials/topic-header') %>
<div class="cols">
  <section class="card flush wide" style="display:block">
    <div class="scroll-x"><table class="table">
      <thead><tr><th>Person</th><th>Role in topic</th><th>Joined</th><% if (isTopicLeader) { %><th><span class="sr">Actions</span></th><% } %></tr></thead>
      <tbody>
      <% members.forEach((m) => { %>
        <tr>
          <td><div class="split"><%- u.avatar(m, '', true) %><span><a href="/people/<%= m.id %>" style="color:var(--text);text-decoration:none;font-weight:500"><%= m.name %></a><br><span class="hint"><%= m.title || m.email %></span></span></div></td>
          <td>
            <% if (isTopicLeader && m.id !== me.id) { %>
              <form method="post" action="/topics/<%= topic.id %>/members/<%= m.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr" for="r<%= m.id %>">Role</label>
                <select id="r<%= m.id %>" name="role" class="in" style="height:32px;width:auto" data-autosubmit><% ['leader', 'member', 'guest'].forEach((r) => { %><option value="<%= r %>"<%= m.role === r ? ' selected' : '' %>><%= r[0].toUpperCase() + r.slice(1) %></option><% }) %></select>
                <noscript><button class="btn btn-s btn-sm">Save</button></noscript></form>
            <% } else { %><%- u.roleTag(m.role) %><% } %>
          </td>
          <td class="hint"><%= u.fmtDate(m.joined_at, { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
          <% if (isTopicLeader) { %><td style="text-align:right">
            <% if (m.id !== me.id) { %><form method="post" action="/topics/<%= topic.id %>/members/<%= m.id %>" data-confirm="Remove <%= m.name %> from <%= topic.code %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="remove"><button class="btn btn-d btn-sm">Remove</button></form><% } %>
          </td><% } %>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  </section>
  <div class="narrow">
    <% if (isTopicLeader) { %>
    <form method="post" action="/topics/<%= topic.id %>/members" class="card" style="display:flex;flex-direction:column;gap:12px">
      <h2>Add someone</h2>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="user_id">Person</label><select id="user_id" name="user_id" required><option value="">Choose…</option><% others.forEach((o) => { %><option value="<%= o.id %>"><%= o.name %> — <%= o.email %><%= o.platform_role === 'guest' ? ' (guest)' : '' %></option><% }) %></select></div>
      <div class="field"><label for="role">Role</label><select id="role" name="role"><option value="member">Co-author</option><option value="leader">Leader (co-lead)</option><option value="guest">Guest (read only)</option></select></div>
      <button class="btn btn-p">Add to topic</button>
      <span class="hint">Not on CTENT yet? Send them an invite link below.</span>
    </form>
    <section class="card" id="invite" style="display:flex;flex-direction:column;gap:12px">
      <h2>Invite with a link</h2>
      <p class="text-2" style="font-size:13.5px"><%= googleOn ? 'Anyone with the link signs in with Google and joins this project. No password needed.' : 'Anyone with the link creates an account and joins this project.' %></p>
      <% invs.forEach((i) => { %>
        <div class="inv-row">
          <span class="inv-link" data-i18n-skip><%= i.link %></span>
          <button type="button" class="btn btn-p btn-sm" data-copy="<%= i.link %>"><%- u.icon('copy', 14) %>Copy</button>
          <span class="hint" style="flex-basis:100%"><%= i.role === 'leader' ? 'Joins as leader' : i.role === 'guest' ? 'Joins as guest (read only)' : 'Joins as co-author' %> · <%= i.uses %> joined · until <%= u.fmtDate(i.expires_at) %></span>
          <form method="post" action="/topics/<%= topic.id %>/invites" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="revoke"><input type="hidden" name="id" value="<%= i.id %>"><button class="btn-link">Turn off</button></form>
        </div>
      <% }) %>
      <form method="post" action="/topics/<%= topic.id %>/invites" style="display:flex;flex-direction:column;gap:10px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="split" style="flex-wrap:wrap">
          <div class="field" style="flex:1 1 140px"><label for="ir">They join as</label><select id="ir" name="role"><option value="member">Co-author</option><option value="guest">Guest (read only)</option><option value="leader">Leader (co-lead)</option></select></div>
          <div class="field" style="flex:1 1 120px"><label for="idays">Link works for</label><select id="idays" name="days"><option value="1">1 day</option><option value="7">7 days</option><option value="14" selected>14 days</option><option value="30">30 days</option></select></div>
        </div>
        <button class="btn btn-s"><%- u.icon('plus', 15) %><%= invs.length ? 'Make another link' : 'Make an invite link' %></button>
      </form>
    </section>
    <% } %>
    <section class="card"><h3 style="margin-bottom:8px">Roles in a topic</h3>
      <p class="text-2" style="font-size:13px"><b>Leader</b> plans the parts, runs the agents, picks the evidence and writes the paper. <b>Co-author</b> reads the evidence, comments, suggests edits to the paper and joins chat and meetings. <b>Guest</b> can only read the project page and files.</p></section>
  </div>
</div>
<%- include('../partials/bottom') %>
