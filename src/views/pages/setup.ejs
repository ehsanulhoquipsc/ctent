<%- include('../partials/head') %>
<body>
<main class="auth">
  <div class="auth-card">
    <img class="logo" src="/static/img/logo.png" alt="CTENT">
    <div><span class="mono">First-time setup</span><h1 style="margin-top:4px">Create the admin account</h1><p class="text-2" style="margin-top:6px">The admin has full access: users, topics, roles and security settings.</p></div>
    <% if (error) { %><div class="alert err" role="alert"><%= error %></div><% } %>
    <form method="post" action="/setup" style="display:flex;flex-direction:column;gap:14px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="name">Full name</label><input id="name" name="name" required value="<%= v.name || '' %>"></div>
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required value="<%= v.email || '' %>"></div>
      <div class="field"><label for="institution">Institution</label><input id="institution" name="institution" value="<%= v.institution || '' %>"></div>
      <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" minlength="10" required autocomplete="new-password"><span class="hint">At least 10 characters.</span></div>
      <div class="field"><label for="password2">Repeat password</label><input id="password2" name="password2" type="password" minlength="10" required autocomplete="new-password"></div>
      <button class="btn btn-p" type="submit">Create admin account</button>
    </form>
  </div>
</main>
</body>
</html>
