<%- include('../partials/top') %>
<div class="page-head"><div><span class="mono"><%= topic.code %> · <%= topic.title %></span><h1>Create a task</h1><p>A clear brief means fewer questions later. The preview shows exactly what they’ll see.</p></div><a class="btn btn-s" href="/topics/<%= topic.id %>/board">Cancel</a></div>
<form method="post" action="/topics/<%= topic.id %>/tasks/new" class="cols" data-brief>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="wide">
    <section class="card" style="display:flex;flex-direction:column;gap:16px">
      <div class="split"><span class="num">1</span><h2>What needs doing</h2></div>
      <div class="field"><label for="tt">Task title</label><input id="tt" name="title" required minlength="3" maxlength="240" placeholder="Start with a verb, e.g. ‘Draft the downstream impact section’" data-bind="title"><span class="hint" data-verb-hint>Tip: start with a verb so it reads like a to-do.</span></div>
      <% if (parts.length) { %>
      <fieldset class="field" style="border:0;padding:0;margin:0"><legend class="label" style="margin-bottom:6px">Part of the plan</legend>
        <div class="chips"><label class="chip pick"><input type="radio" name="part_id" value=""<%= !part ? ' checked' : '' %> data-bind-label="part"> None</label><% parts.forEach((p) => { %><label class="chip pick"><input type="radio" name="part_id" value="<%= p.id %>"<%= part && part.id === p.id ? ' checked' : '' %> data-bind-label="part"> <%= p.title %></label><% }) %></div>
        <span class="hint">Pick a part to rank people by expertise for it. <% if (!part) { %><a href="?part=<%= parts[0].id %>">Rank for “<%= parts[0].title %>”</a><% } %></span>
      </fieldset>
      <% } %>
      <fieldset class="field" style="border:0;padding:0;margin:0"><legend class="label" style="margin-bottom:6px">What should they hand in?</legend>
        <div class="chips"><% Object.entries(deliverables).forEach(([k, d], i) => { %><label class="chip pick"><input type="radio" name="deliverable" value="<%= k %>"<%= i === 0 ? ' checked' : '' %> data-bind-label="deliverable"> <%= d[0] %> <%= d[1] %></label><% }) %></div>
      </fieldset>
    </section>

    <section class="card" style="display:flex;flex-direction:column;gap:16px">
      <div class="split"><span class="num">2</span><h2>Who and when</h2></div>
      <fieldset class="field" style="border:0;padding:0;margin:0"><legend class="label" style="margin-bottom:2px">Give it to</legend>
        <span class="hint" style="margin-bottom:8px"><%= part ? 'Ranked by expertise match for “' + part.title + '” and how busy they are. You decide.' : 'Sorted by how busy they are. You decide.' %></span>
        <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px">
          <% people.forEach((p, i) => { %>
            <label class="person-pick"><input type="radio" name="assignee_id" value="<%= p.id %>"<%= i === 0 ? ' checked' : '' %> data-name="<%= p.name %>">
              <span class="split" style="width:100%"><%- u.avatar(p) %><span style="flex:1;min-width:0"><b style="font-size:14px"><%= p.name %></b><br><span class="hint"><%= p.load ? p.load + ' open task' + (p.load > 1 ? 's' : '') : 'Free right now' %></span></span><% if (i === 0 && part && p.score > 0) { %><span class="tag" style="background:var(--green-soft);color:var(--green)">Best fit</span><% } %></span>
              <% if (part) { %><span class="split" style="width:100%"><span class="bar" style="flex:1"><span style="width:<%= p.score %>%;background:<%= p.score >= 70 ? 'var(--green)' : p.score >= 40 ? 'var(--amber)' : 'var(--muted)' %>"></span></span><span class="mono" style="text-transform:none"><%= p.score %>% match</span></span><% } %>
            </label>
          <% }) %>
        </div>
      </fieldset>
      <div class="split" style="align-items:flex-start;gap:24px">
        <fieldset class="field" style="border:0;padding:0;margin:0;flex:2 1 300px"><legend class="label" style="margin-bottom:6px">Due</legend>
          <div class="chips"><% dues.forEach(([k, t, d], i) => { %><label class="chip pick"><input type="radio" name="due_pick" value="<%= d %>"<%= i === 1 ? ' checked' : '' %> data-due> <%= t %> <span class="hint"><%= u.fmtDate(d) %></span></label><% }) %><input class="in" type="date" name="due_date" value="<%= dues[1][2] %>" style="width:auto;height:34px" data-due-input data-bind="due" aria-label="Due date"></div>
        </fieldset>
        <fieldset class="field" style="border:0;padding:0;margin:0;flex:1 1 200px"><legend class="label" style="margin-bottom:6px">Priority</legend>
          <div class="chips"><% [['low', 'Low'], ['normal', 'Normal'], ['high', 'High']].forEach(([k, l]) => { %><label class="chip pick"><input type="radio" name="priority" value="<%= k %>"<%= k === 'normal' ? ' checked' : '' %> data-bind-label="priority"> <%= l %></label><% }) %></div>
        </fieldset>
      </div>
    </section>

    <section class="card" style="display:flex;flex-direction:column;gap:16px">
      <div class="split"><span class="num">3</span><h2>The brief</h2></div>
      <div class="field"><label for="goal">Goal — why this matters</label><textarea id="goal" name="goal" rows="3" maxlength="2000" placeholder="One or two sentences. What question does this answer for the topic?" data-bind="goal"></textarea></div>
      <div class="field">
        <span class="label">Done when… <span class="hint" style="font-weight:400">— you’ll tick these at review</span></span>
        <div data-crit-list style="display:flex;flex-direction:column;gap:6px"></div>
        <div class="split"><input class="in" data-crit-input placeholder="e.g. ‘At least 8 cited sources’" aria-label="New done-when point" style="flex:1"><button type="button" class="btn btn-s" data-crit-add>Add</button></div>
        <div class="chips" style="margin-top:4px"><span class="hint" style="align-self:center">Suggestions:</span><% ['At least 8 cited sources', '1,500–2,500 words', 'Includes one figure or map', 'Data and code are in Files'].forEach((s) => { %><button type="button" class="chip" data-crit-sug="<%= s %>" style="border-style:dashed">+ <%= s %></button><% }) %></div>
        <noscript><input class="in" name="criteria" required placeholder="Done when…"></noscript>
      </div>
      <div class="field"><label for="steps">Suggested first steps <span class="hint" style="font-weight:400">(optional, one per line — they can change these)</span></label><textarea id="steps" name="steps" rows="3" placeholder="Read the starter sources&#10;Outline the section&#10;Write the first draft"></textarea></div>
      <% if (files.length) { %>
      <fieldset class="field" style="border:0;padding:0;margin:0"><legend class="label" style="margin-bottom:6px">Starter files</legend>
        <div class="chips"><% files.slice(0, 12).forEach((f) => { %><label class="chip pick teal"><input type="checkbox" name="resources" value="<%= f.id %>" data-bind-res="<%= f.name %>"> <%= f.name %></label><% }) %></div>
        <span class="hint">From this topic’s Files. They appear in the brief as one-click links.</span>
      </fieldset>
      <% } %>
    </section>

    <div class="card split" style="justify-content:flex-end">
      <span class="text-2" style="flex:1 1 280px" data-send-hint>Add a title and at least one “done when” point to send.</span>
      <button class="btn btn-p" data-send>Send task →</button>
    </div>
  </div>

  <aside class="narrow" style="position:sticky;top:80px">
    <section class="card" style="display:flex;flex-direction:column;gap:10px">
      <div class="split"><b style="flex:1">Brief quality</b><span class="tag" data-score-pill>0/5</span></div>
      <div class="bar"><span data-score-bar style="width:0%"></span></div>
      <div data-checks style="display:flex;flex-direction:column;gap:6px;font-size:13px"></div>
    </section>
    <section class="preview">
      <span class="mono">Live preview · what <span data-out="who">they</span> will see</span>
      <div class="card" style="display:flex;flex-direction:column;gap:10px;padding:16px">
        <span class="mono" data-out="part"><%= topic.code %></span>
        <b style="font-size:17px;line-height:1.3" data-out="title">Untitled task</b>
        <div class="split" style="font-size:12px;color:var(--text-2)"><%- u.avatar(me, 'sm') %><%= me.name.split(' ')[0] %> → <b style="color:var(--text)" data-out="who">—</b><span class="tag right" style="background:var(--amber-soft);color:var(--amber)">Due <span data-out="due">—</span></span></div>
        <div class="alert info" style="font-size:13px;display:block"><b>Your next step</b><br>Read the brief, then press <b>Start working</b>.</div>
        <div style="font-size:13px"><b>Goal</b><br><span class="text-2" data-out="goal">—</span></div>
        <div style="font-size:13px"><b>Deliver</b> · <span data-out="deliverable">—</span> · <span data-out="priority">—</span> priority</div>
        <div style="font-size:13px;display:flex;flex-direction:column;gap:4px"><b>Done when</b><div data-out-crit class="text-2"></div></div>
        <div class="chips" data-out-res></div>
      </div>
    </section>
  </aside>
</form>
<%- include('../partials/bottom') %>
