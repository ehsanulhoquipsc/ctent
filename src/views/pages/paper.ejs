<%- include('../partials/top') %>
<%- include('../partials/topic-header') %>
<% const P = '/topics/' + topic.id + '/paper'; const ro = !isTopicLeader || topic.status === 'archived'; const S = P + '/sections/' + cur.id; %>
<section class="split" style="flex-wrap:wrap;align-items:flex-end">
  <div style="flex:1 1 420px;min-width:0;display:flex;flex-direction:column;gap:6px">
    <span class="mono">Final paper</span>
    <h1 style="font-size:24px"><%= topic.title %></h1>
    <div class="split" style="flex-wrap:wrap;gap:14px;font-size:13px;color:var(--text-2)"><span><b style="color:var(--text)"><%= sections.filter((s) => s.filled).length %> of <%= sections.length %></b> sections written</span><span><b style="color:var(--text)"><%= accepted %> of <%= partCount %></b> parts’ findings accepted</span><span>~<%= wordCount.toLocaleString('en') %> words</span><span><%= refs.length %> references</span></div>
  </div>
  <a class="btn btn-s" href="<%= P %>.docx"><%- u.icon('download', 16) %>Word</a>
  <a class="btn btn-s" href="<%= P %>/print" target="_blank" rel="noopener">Print / PDF</a>
  <% if (!ro) { %><form method="post" action="<%= P %>/final" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-p">Save as final report →</button></form><% } %>
</section>
<% if (!accepted) { %><div class="alert info"><span>No findings are accepted yet. <a href="/topics/<%= topic.id %>/findings">Review your agents’ findings</a> — accepted findings appear on the right, ready to insert with their citations.</span></div><% } %>
<div class="paper-cols">
  <nav class="card" aria-label="Paper outline" style="flex:1 1 220px;max-width:290px;min-width:0;display:flex;flex-direction:column;gap:2px;padding:12px">
    <span class="mono" style="padding:4px 8px 8px">Outline</span>
    <% sections.forEach((s) => { const st = s.filled ? 'var(--green)' : s.part && s.part.agent_status === 'accepted' ? 'var(--amber)' : 'var(--line)'; %>
      <a class="outline<%= s.id === cur.id ? ' on' : '' %>" href="<%= P %>?s=<%= s.id %>"<%- s.id === cur.id ? ' aria-current="true"' : '' %>><span class="dot" style="background:<%= st %>"></span><span style="flex:1;min-width:0"><span style="display:block"><%= s.title %></span><span class="hint"><%= s.filled ? 'Written' : s.part ? (s.part.agent_status === 'accepted' ? 'Findings ready to use' : 'Waiting for findings') : 'Your words' %></span></span></a>
    <% }) %>
    <span class="outline" style="cursor:default"><span class="dot" style="background:<%= refs.length ? 'var(--green)' : 'var(--line)' %>"></span><span><span style="display:block">References</span><span class="hint">Automatic</span></span></span>
    <% if (!ro) { %><form method="post" action="<%= P %>/sections" class="split" style="margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr" for="ns">New section</label><input class="in" id="ns" name="title" placeholder="New section" style="height:36px;flex:1" required><button class="btn btn-s btn-sm">Add</button></form><% } %>
  </nav>

  <section class="card" style="flex:3 1 480px;min-width:0;padding:0;display:flex;flex-direction:column">
    <div class="split" style="flex-wrap:wrap;padding:10px 14px;border-bottom:1px solid var(--line-2)">
      <span class="mono" style="flex:1"><%= cur.part ? 'From Part · ' + (cur.part.agent_name || 'agent') : 'Your words' %></span>
      <% if (!ro) { %>
        <form method="post" action="<%= S %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-s btn-sm" name="action" value="up" aria-label="Move section up" title="Move up">↑</button><button class="btn btn-s btn-sm" name="action" value="down" aria-label="Move section down" title="Move down">↓</button></form>
        <form method="post" action="<%= S %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="draft"><button class="btn btn-s btn-sm"><%- u.icon('spark', 16) %>Draft from findings</button></form>
        <% if (!editing) { %><a class="btn btn-p btn-sm" href="<%= P %>?s=<%= cur.id %>&edit=1"><%- u.icon('edit', 16) %>Edit</a><% } %>
      <% } %>
    </div>
    <% if (editing && !ro) { %>
      <form method="post" action="<%= S %>" style="padding:20px 24px;display:flex;flex-direction:column;gap:12px">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="save">
        <div class="field"><label for="st">Section title</label><input id="st" name="title" value="<%= cur.title %>" maxlength="240" required></div>
        <div class="field"><label for="sb">Text</label><textarea id="sb" name="body" rows="18" class="paper-edit"><%= cur.body || '' %></textarea><span class="hint">Leave a blank line between paragraphs. Citations look like [src:12] — keep each one next to the sentence it supports and the reference list updates itself.</span></div>
        <div class="split" style="flex-wrap:wrap"><button class="btn btn-p">Save section</button><a class="btn btn-s" href="<%= P %>?s=<%= cur.id %>">Cancel</a><span style="flex:1"></span><%- u.delForm(S, csrf, 'Delete the section “' + cur.title + '”?', 'Delete section', { action: 'delete' }) %></div>
      </form>
    <% } else { %>
      <article class="paper-view">
        <h2><%= cur.title %></h2>
        <% if (cur.html) { %><%- cur.html %><% } else { %><div class="empty" style="padding:24px;border:1.5px dashed var(--line);border-radius:10px"><span><%= cur.part && cur.part.agent_status !== 'accepted' ? 'This section waits for its agent’s findings. Accept them, then insert or draft from them.' : ro ? 'Nothing written yet.' : 'Nothing written yet. Insert findings from the right, draft from them, or press Edit and start typing.' %></span></div><% } %>
      </article>
    <% } %>
  </section>

  <aside style="flex:1 1 290px;min-width:0;display:flex;flex-direction:column;gap:16px">
    <section class="card" style="display:flex;flex-direction:column;gap:4px">
      <div class="split" style="padding-bottom:6px"><h3 style="flex:1"><%= cur.part ? 'Findings for this section' : 'All accepted findings' %></h3><span class="mono"><%= findings.length %></span></div>
      <% if (!findings.length) { %><span class="hint"><%= cur.part ? 'None accepted for this part yet.' : 'Accept findings on the Findings tab to use them here.' %></span><% } %>
      <% findings.forEach((f) => { %>
        <div style="display:flex;flex-direction:column;gap:8px;padding:12px 0;border-top:1px solid var(--line-2)">
          <span style="font-size:14px;line-height:1.5"><%= f.text %></span>
          <div class="split" style="flex-wrap:wrap"><span class="hint" style="flex:1"><% if (!cur.part) { %><%= f.part.title %> · <% } %><%= f.confidence %> · <%= f.srcIds.length %> source<%= f.srcIds.length === 1 ? '' : 's' %></span>
            <% if (!ro) { %><form method="post" action="<%= S %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="insert"><input type="hidden" name="finding" value="<%= f.id %>"><button class="btn btn-s btn-sm"<%= f.used ? ' disabled' : '' %>><%= f.used ? 'Inserted' : 'Insert' %></button></form><% } %>
          </div>
        </div>
      <% }) %>
    </section>
    <section class="card" id="comments" style="display:flex;flex-direction:column;gap:10px">
      <div class="split"><h3 style="flex:1">Suggestions</h3><span class="mono"><%= comments.filter((c) => !c.resolved).length %> open</span></div>
      <% if (!comments.length) { %><span class="hint">Co-authors can suggest edits to this section here.</span><% } %>
      <% comments.forEach((c) => { %><div class="split" style="align-items:flex-start;<%= c.resolved ? 'opacity:.6' : '' %>"><%- u.avatar({ id: c.uid, name: c.name || '?', color: c.color }, 'sm') %><div style="flex:1;min-width:0"><div class="split"><b style="font-size:13px"><%= c.name || 'Former member' %></b><span class="mono" style="text-transform:none"><%= c.resolved ? 'Resolved' : u.ago(c.created_at) %></span></div><p style="font-size:14px;line-height:1.5;white-space:pre-wrap"><%= c.body %></p>
        <% if (!c.resolved && (isTopicLeader || c.uid === me.id) && topic.status !== 'archived') { %><form method="post" action="<%= S %>/comments" class="split" style="margin-top:6px"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= c.id %>"><button class="btn btn-s btn-sm" name="action" value="resolve">Resolve</button><button class="mini del" name="action" value="delete"><%- u.icon('trash') %>Delete</button></form><% } %></div></div><% }) %>
      <% if (!isGuest && topic.status !== 'archived') { %><form method="post" action="<%= S %>/comments" style="display:flex;flex-direction:column;gap:8px"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr" for="cm">Suggestion</label><textarea class="in" id="cm" name="body" rows="2" maxlength="2000" required placeholder="Suggest an edit to this section…"></textarea><button class="btn btn-s btn-sm" style="align-self:flex-start">Post</button></form><% } %>
    </section>
    <section class="card" style="display:flex;flex-direction:column;gap:8px">
      <h3>References</h3>
      <% if (!refs.length) { %><span class="hint">Built automatically from the sources behind every finding you use.</span><% } %>
      <ol class="refs"><% refs.forEach((x) => { %><li id="ref<%= x.n %>"><% if (x.url) { %><a href="<%= u.safeUrl(x.url) || '#' %>" target="_blank" rel="noopener noreferrer"><%= x.text %></a><% } else { %><%= x.text %><% } %></li><% }) %></ol>
    </section>
  </aside>
</div>
<%- include('../partials/bottom') %>
