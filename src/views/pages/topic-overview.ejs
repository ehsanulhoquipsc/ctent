<%- include('../partials/top') %>
<%- include('../partials/topic-header') %>
<% const J = journey; const nx = J.next; const cur = J.steps.find((s) => s.current); %>
<section class="next-card<%= topic.status === 'completed' ? ' done' : '' %>">
  <div class="next-step"><%= topic.status === 'completed' ? '🏆' : cur ? cur.n : '✓' %></div>
  <div style="flex:1 1 340px;min-width:0;display:flex;flex-direction:column;gap:6px">
    <span class="mono"><%= topic.status === 'completed' ? 'Finished' + (topic.completed_at ? ' · ' + u.fmtDate(topic.completed_at, { day: 'numeric', month: 'short', year: 'numeric' }) : '') : cur ? 'Step ' + cur.n + ' of 5 · ' + cur.label : 'Next step' %></span>
    <h2 style="font-size:21px;line-height:1.3"><%= nx.title %></h2>
    <p class="text-2"><%= nx.text %></p>
  </div>
  <% if (nx.label && (nx.action || nx.href)) { %>
    <% if (nx.action) { %><form method="post" action="<%= nx.action %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-p btn-lg"><%= nx.label %> →</button></form>
    <% } else { %><a class="btn btn-p btn-lg" href="<%= nx.href %>"><%= nx.label %> →</a><% } %>
  <% } %>
</section>

<div class="cols">
  <div class="wide">
    <section class="card" id="question" style="display:flex;flex-direction:column;gap:8px">
      <div class="split"><span class="mono" style="flex:1">Research question</span><% if (isTopicLeader && topic.status !== 'archived') { %><a href="/topics/<%= topic.id %>/agents#question" style="font-size:13px">Edit</a><% } %></div>
      <p style="font-size:17px;line-height:1.55" data-i18n-skip><%= topic.question || 'No research question yet.' %></p>
      <% if (topic.description) { %><p class="text-2" style="white-space:pre-wrap;font-size:14px" data-i18n-skip><%= topic.description %></p><% } %>
    </section>

    <section class="card flush">
      <div class="card-head" style="padding:18px 20px 6px"><h2>Parts</h2><span class="mono"><%= J.counts.accepted %> of <%= J.counts.parts %> ready for the paper</span></div>
      <% if (!parts.length) { %><div class="empty" style="padding:22px">No parts yet.<% if (isTopicLeader) { %> <a href="/topics/<%= topic.id %>/agents#parts">Plan the parts</a><% } %></div><% } %>
      <div class="list">
        <% parts.forEach((p, i) => { const s = u.agentStatus(p.agent_status); const working = ['queued', 'running'].includes(p.agent_status); %>
          <a class="part-row" href="<%= isGuest ? '#' : '/topics/' + topic.id + '/agents/' + p.id %>" data-agent="<%= p.id %>">
            <span class="part-n"><%= String(i + 1).padStart(2, '0') %></span>
            <span style="flex:1;min-width:0;display:flex;flex-direction:column;gap:4px"><b data-i18n-skip><%= p.title %></b>
              <% if (working) { %><span data-progress><span class="bar"><span style="width:<%= p.agent_progress || 0 %>%;background:var(--indigo)"></span></span></span><% } else { %><span class="hint"><%= s.help %></span><% } %></span>
            <span class="tag dotted" style="background:<%= s.c[1] %>;color:<%= s.c[0] %>"><%= s.label %></span>
          </a>
        <% }) %>
      </div>
    </section>
  </div>
  <aside class="narrow">
    <section class="card" style="display:flex;flex-direction:column;gap:12px">
      <div class="card-head"><h3>Progress</h3><b style="font-size:20px"><%= J.pct %>%</b></div>
      <div class="bar"><span style="width:<%= J.pct %>%"></span></div>
      <div class="glance">
        <div><b><%= J.counts.researched %>/<%= J.counts.parts %></b><span>parts researched</span></div>
        <div><b><%= J.counts.accepted %>/<%= J.counts.parts %></b><span>accepted</span></div>
        <div><b><%= J.counts.filled %>/<%= J.counts.sections || 0 %></b><span>sections written</span></div>
        <div><b><%= topic.due_date ? u.fmtDate(topic.due_date, { day: 'numeric', month: 'short' }) : '—' %></b><span>target end</span></div>
      </div>
    </section>
    <section class="card" style="display:flex;flex-direction:column;gap:10px">
      <div class="card-head"><h3>Team</h3><% if (!isGuest) { %><a href="/topics/<%= topic.id %>/members" style="font-size:13px"><%= isTopicLeader ? 'Invite' : 'All' %></a><% } %></div>
      <div class="split" style="flex-wrap:wrap"><% (topicMembersPreview || []).forEach((m) => { %><%- u.avatar(m, 'sm', true) %><% }) %><span class="hint"><%= memberCount %> <%= memberCount === 1 ? 'person' : 'people' %></span></div>
      <% if (meetings.length) { %><div style="border-top:1px solid var(--line-2);padding-top:10px;display:flex;flex-direction:column;gap:8px"><span class="mono">Next meetings</span>
        <% meetings.forEach((m) => { %><div class="split"><span style="flex:1;min-width:0;font-size:13px"><b style="font-weight:500" data-i18n-skip><%= m.title %></b><br><span class="hint"><%= u.fmtDateTime(m.starts_at) %></span></span><% if (m.link && !isGuest) { %><a class="btn btn-s btn-sm" href="<%= m.link %>" target="_blank" rel="noopener">Join</a><% } %></div><% }) %></div><% } %>
    </section>
    <% if (!isGuest && activity.length) { %>
    <section class="card"><div class="card-head"><h3>Latest activity</h3><a href="/topics/<%= topic.id %>/activity" style="font-size:13px">All</a></div>
      <% activity.slice(0, 5).forEach((a) => { %><div class="row" style="align-items:flex-start;padding:8px 0"><%- u.avatar(a.uid ? { id: a.uid, name: a.name, color: a.color } : null, 'sm') %><span style="flex:1;font-size:13px"><%= a.detail %><br><span class="mono" style="text-transform:none"><%= u.ago(a.created_at) %></span></span></div><% }) %>
    </section>
    <% } %>
  </aside>
</div>
<% if (J.counts.working && !isGuest) { %><span hidden data-agent-poll="/topics/<%= topic.id %>/agents/status.json"></span><% } %>
<%- include('../partials/bottom') %>
