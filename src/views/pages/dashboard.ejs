<%- include('../partials/top', { crumb: 'Home' }) %>
<% const first = me.name.replace(/^Dr\.\s*/, '').split(' ')[0]; const canCreate = me.platform_role === 'leader' || me.platform_role === 'admin'; %>
<div class="home">
  <div>
    <h1 class="hello">Good <%= hour < 12 ? 'morning' : hour < 18 ? 'afternoon' : 'evening' %>, <span data-i18n-skip><%= first %></span></h1>
    <p class="text-2" style="font-size:16px;margin-top:8px"><%= nActive %> project<%= nActive === 1 ? '' : 's' %> · <%= needCount %> thing<%= needCount === 1 ? '' : 's' %> need<%= needCount === 1 ? 's' : '' %> you</p>
  </div>

  <% if (upNext.length) { %>
  <section class="stack" data-tip-title="Up next" data-tip="Up next shows the most useful step in each of your projects. Click one to go straight there.">
    <h2>Up next</h2>
    <div class="upnext">
      <% upNext.forEach((x) => { const c = u.color(x.topic.color); const n = x.next; %>
        <% if (n.action) { %>
        <form class="un-card" method="post" action="<%= n.action %>" style="--acc:<%= c[0] %>;--acc-soft:<%= c[1] %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <span class="un-top"><% if (x.step) { %><span class="un-num"><%= x.step %></span><% } %><span class="ptag" data-i18n-skip><%= x.topic.title.length > 34 ? x.topic.title.slice(0, 32) + '…' : x.topic.title %></span></span>
          <b class="un-t"><%= n.title %></b><span class="un-x"><%= n.text %></span>
          <button class="un-go"><%= n.label %> →</button>
        </form>
        <% } else { %>
        <a class="un-card" href="<%= n.href %>" style="--acc:<%= c[0] %>;--acc-soft:<%= c[1] %>">
          <span class="un-top"><% if (x.step) { %><span class="un-num"><%= x.step %></span><% } %><span class="ptag" data-i18n-skip><%= x.topic.title.length > 34 ? x.topic.title.slice(0, 32) + '…' : x.topic.title %></span></span>
          <b class="un-t"><%= n.title %></b><span class="un-x"><%= n.text %></span>
          <span class="un-go"><%= n.label %> →</span>
        </a>
        <% } %>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="stack">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap"><h2 style="flex:1">Your projects</h2>
      <nav class="seg" aria-label="Show"><a href="/"<%- show === 'active' ? ' class="on" aria-current="true"' : '' %>>Active · <%= nActive %></a><a href="/?show=finished"<%- show === 'finished' ? ' class="on" aria-current="true"' : '' %>>Finished · <%= nFinished %></a></nav>
    </div>
    <% if (!projects.length) { %>
      <div class="card empty2">
        <span class="e-ico"><%- u.icon(show === 'finished' ? 'check' : 'folder', 24) %></span>
        <b><%= show === 'finished' ? 'No finished projects yet' : 'No projects yet' %></b>
        <span><%= show === 'finished' ? 'When you save a final report, the project moves here.' : canCreate ? 'Start with a research question. AI agents or your team split it into parts and find the evidence.' : 'When a project leader adds you to a project, it shows up here.' %></span>
        <% if (show !== 'finished' && canCreate) { %><a class="btn btn-p" href="/topics/new"><%- u.icon('plus') %>Start a project</a><% } %>
      </div>
    <% } %>
    <% projects.forEach((t) => { const c = u.color(t.color); const j = t.j; const cn = j.counts; %>
      <article class="card pj" style="--acc:<%= c[0] %>;--acc-soft:<%= c[1] %>">
        <div class="pj-top">
          <span class="pj-badge"><%= String(t.code).replace(/^CT-0*/, '') %></span>
          <div style="flex:1 1 320px;min-width:0"><div class="mono"><%= t.code %><%= t.field ? ' · ' + t.field : '' %><%= t.status === 'completed' ? ' · finished ' + u.fmtDate(t.completed_at) : t.due_date ? ' · due ' + u.fmtDate(t.due_date) : '' %> · <%= j.mode === 'manual' ? 'Manual mode' : 'Agent mode' %></div><a class="pj-title" href="/topics/<%= t.id %>" data-i18n-skip><%= t.title %></a></div>
          <span class="avs"><% t.team.slice(0, 4).forEach((m) => { %><%- u.avatar(m, 'sm') %><% }) %><% if (t.team.length > 4) { %><span class="av sm more">+<%= t.team.length - 4 %></span><% } %></span>
        </div>
        <ol class="jbar" aria-label="Journey"<%- t === projects[0] ? ' data-tip-title="Every project has a journey" data-tip="From question to finished paper. The coloured step is where the project is now."' : '' %>>
          <% j.steps.forEach((s) => { %><li class="<%= s.done ? 'done' : s.current ? 'cur' : '' %>"><span></span><b><%= s.label %></b></li><% }) %>
        </ol>
        <div class="pj-foot">
          <span class="live<%= cn.working ? ' on' : '' %>" aria-hidden="true"></span>
          <span class="pj-status"><%= t.status === 'completed' ? 'Finished · final report saved' : (j.current ? 'Step ' + j.current.n + ' of ' + j.steps.length : '') + (cn.parts ? ' · ' + cn.accepted + ' of ' + cn.parts + ' parts accepted' : '') + (cn.working ? ' · ' + cn.working + ' still researching' : '') + (cn.sections && j.current && j.current.key === 'write' ? ' · ' + cn.filled + ' of ' + cn.sections + ' sections written' : '') %></span>
          <a class="btn btn-s btn-sm" href="/topics/<%= t.id %>">Open</a>
          <% if (j.next && j.next.action) { %><form method="post" action="<%= j.next.action %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-p btn-sm acc"><%= j.next.label %> →</button></form>
          <% } else if (j.next && j.next.href && j.next.label && j.next.label !== 'Open') { %><a class="btn btn-p btn-sm acc" href="<%= j.next.href %>"><%= j.next.label %> →</a><% } %>
        </div>
      </article>
    <% }) %>
    <% if (canCreate && show === 'active' && projects.length) { %><a class="new-dash" href="/topics/new"><%- u.icon('plus') %>Start a new research project</a><% } %>
  </section>
</div>
<%- include('../partials/bottom') %>
