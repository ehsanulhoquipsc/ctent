<%- include('../partials/head') %>
<body>
<main class="auth">
  <div class="auth-lang"><%- include('../partials/lang-menu') %></div>
  <div class="auth-card getapp">
    <img class="getapp-icon" src="/static/img/icon-192.png?v=<%= assetV %>" alt="CTENT app icon" width="88" height="88">
    <div style="text-align:center;display:flex;flex-direction:column;gap:6px">
      <h1>Get the CTENT app</h1>
      <p class="text-2">Your research group’s workspace on your phone or computer. Free — no app store needed.</p>
    </div>

    <button type="button" class="btn btn-p getapp-btn" data-install-app hidden>Install CTENT</button>
    <p class="getapp-done" data-installed-note hidden>CTENT is installed — open it from your home screen or apps.</p>

    <div class="getapp-steps">
      <section data-os="ios">
        <h2>iPhone or iPad</h2>
        <ol><li>Open this page in <b>Safari</b>.</li><li>Tap <b>Share</b> <%- u.icon('upload', 15) %> at the bottom of the screen.</li><li>Choose <b>Add to Home Screen</b>, then <b>Add</b>.</li></ol>
      </section>
      <section data-os="android">
        <h2>Android</h2>
        <ol><li>Open this page in <b>Chrome</b>.</li><li>Tap <b>Install CTENT</b> above — or the <b>⋮</b> menu › <b>Install app</b>.</li></ol>
      </section>
      <section data-os="desktop">
        <h2>Computer (Windows or Mac)</h2>
        <ol><li>Open this page in <b>Chrome</b> or <b>Edge</b>.</li><li>Click <b>Install CTENT</b> above — or the install icon at the right of the address bar.</li></ol>
      </section>
    </div>

    <div class="getapp-next">
      <% if (signedIn) { %>
        <a class="btn btn-s" href="/">Open my workspace</a>
      <% } else { %>
        <b>Then sign in</b>
        <p class="text-2">Got an invite link from your team? Open that link first to join. Already have an account? Sign in.</p>
        <a class="btn btn-s" href="/login">Sign in</a>
      <% } %>
    </div>
    <p class="hint" style="text-align:center"><a href="/privacy">Privacy policy</a></p>
  </div>
</main>
<script src="/static/js/app.js?v=<%= assetV %>"></script>
</body>
</html>
