<%
  // One menu for every project page: five tabs, a few sub-tabs where needed, and the journey bar.
  const base = '/topics/' + topic.id;
  const MAIN = {
    Overview: 'Journey', 'Plan & agents': 'Research', Findings: 'Research', 'Plan & assign': 'Research', Board: 'Research',
    'Final paper': 'Paper', Channels: 'Team', Meetings: 'Team', 'Co-authors': 'Team', Members: 'Team', Activity: 'Team',
    Files: 'Files', Submissions: 'Files', Settings: 'Settings'
  };
  const mainTab = MAIN[tab] || 'Journey';
  let TABS = [['Journey', base, 'home'], ['Research', base + '/agents', 'bot'], ['Paper', base + '/paper', 'edit'], ['Team', base + '/channels', 'chat'], ['Files', base + '/files', 'folder']];
  const SUBS = {
    Team: [['Chat', 'Channels', base + '/channels'], ['Meetings', 'Meetings', base + '/meetings'], ['People', 'Co-authors', base + '/members'], ['Activity', 'Activity', base + '/activity']],
    Files: [['All files', 'Files', base + '/files'], ['Submissions', 'Submissions', base + '/submissions']]
  };
  if (isGuest) { TABS = [['Journey', base, 'home'], ['Files', base + '/files', 'folder']]; SUBS.Files = null; }
  const subTab = tab === 'Members' ? 'Co-authors' : tab;
  const subs = SUBS[mainTab] && SUBS[mainTab].some((s) => s[1] === subTab) ? SUBS[mainTab] : null;
  const J = typeof journey !== 'undefined' ? journey : null;
  const showNext = J && J.next && isTopicLeader && mainTab !== 'Journey' && J.next.label && topic.status !== 'archived';
%>
<div class="topic-head">
  <div class="topic-title">
    <span class="topic-badge" style="background:<%= u.color(topic.color)[1] %>;color:<%= u.color(topic.color)[0] %>"><%= String(topic.code).replace(/^CT-0*/, '') %></span>
    <div>
      <span class="mono"><%= topic.code %><%= topic.field ? ' · ' + topic.field : '' %></span>
      <div class="split" style="flex-wrap:wrap"><h1><%= topic.title %></h1><% if (topic.status !== 'active') { %><%- u.tag(topic.status) %><% } %><% if (isGuest) { %><span class="tag" style="background:var(--violet-soft);color:var(--violet)">Read only</span><% } %></div>
    </div>
    <a class="stack" href="<%= isGuest ? base : base + '/members' %>" title="People in this project"><% (topicMembersPreview || []).forEach((m) => { %><%- u.avatar(m, 'sm', true) %><% }) %></a>
    <% if (showNext) { %>
      <% if (J.next.action) { %><form method="post" action="<%= J.next.action %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-p" title="<%= J.next.title %>"><%= topic.status === 'completed' ? '' : 'Next: ' %><%= J.next.label %> →</button></form>
      <% } else if (J.next.href) { %><a class="btn btn-p" href="<%= J.next.href %>" title="<%= J.next.title %>"><%= topic.status === 'completed' ? '' : 'Next: ' %><%= J.next.label %> →</a><% } %>
    <% } %>
  </div>
  <% if (J) { %>
  <ol class="journey-bar" aria-label="Project journey">
    <% J.steps.forEach((s) => { %><li class="<%= s.done ? 'done' : s.current ? 'cur' : '' %>"><a href="<%= isGuest ? base : s.href %>"<%- s.current ? ' aria-current="step"' : '' %>><span class="n"><%= s.done ? '✓' : s.n %></span><span class="t"><b><%= s.label %></b><span><%= s.detail %></span></span></a></li><% }) %>
  </ol>
  <% } %>
  <nav class="ptabs" aria-label="Project sections">
    <% TABS.forEach(([label, href, ic]) => { %><a class="<%= label === mainTab ? 'on' : '' %>" href="<%= href %>"<%- label === mainTab ? ' aria-current="page"' : '' %>><%- u.icon(ic, 16) %><%= label %></a><% }) %>
    <% if (isTopicLeader) { %><a class="gear<%= mainTab === 'Settings' ? ' on' : '' %>" href="<%= base %>/settings" title="Project settings" aria-label="Project settings"><%- u.icon('settings', 16) %><span>Settings</span></a><% } %>
  </nav>
  <% if (subs) { %><nav class="subs" aria-label="<%= mainTab %>"><% subs.forEach(([label, key, href]) => { %><a class="<%= key === subTab ? 'on' : '' %>" href="<%= href %>"<%- key === subTab ? ' aria-current="page"' : '' %>><%= label %></a><% }) %></nav><% } %>
</div>
