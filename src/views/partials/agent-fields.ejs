<% const srcOn = String(p.agent_sources || '').split(','); %>
<div class="field"><label for="<%= idp %>t">Part title</label><input id="<%= idp %>t" name="title" required minlength="3" maxlength="240" value="<%= p.title || '' %>" placeholder="e.g. Downstream water security — India & Bangladesh"></div>
<div class="field"><label for="<%= idp %>b">What should this agent find out?</label><textarea id="<%= idp %>b" name="brief" rows="3" maxlength="1500" placeholder="The question for this part, what to focus on, anything to avoid"><%= p.description || '' %></textarea></div>
<div class="field"><label for="<%= idp %>a">Agent name</label><input id="<%= idp %>a" name="agent_name" maxlength="100" value="<%= p.agent_name || '' %>" placeholder="e.g. Water security agent"></div>
<fieldset class="field" style="border:0;padding:0;margin:0"><legend class="label" style="margin-bottom:6px">Where to look</legend>
  <div class="chips"><% Object.entries(SOURCE_TYPES).forEach(([k, s]) => { %><label class="chip pick" title="<%= s.note %>"><input type="checkbox" name="sources" value="<%= k %>"<%= srcOn.includes(k) ? ' checked' : '' %>> <%= s.label %></label><% }) %></div>
</fieldset>
<fieldset class="field" style="border:0;padding:0;margin:0"><legend class="label" style="margin-bottom:6px">How deep</legend>
  <div class="chips"><% DEPTHS.forEach((d) => { %><label class="chip pick"><input type="radio" name="depth" value="<%= d %>"<%= (p.agent_depth || 'standard') === d ? ' checked' : '' %>> <%= d[0].toUpperCase() + d.slice(1) %> <span class="hint"><%= d === 'quick' ? '~8 sources' : d === 'standard' ? '~14 sources' : '~22 sources' %></span></label><% }) %></div>
</fieldset>
