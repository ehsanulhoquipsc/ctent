# Copy to .env for local settings. On Render these are set in the dashboard / render.yaml.
PORT=3000
# Leave DATABASE_URL empty to use a local SQLite file (data/ctent.sqlite)
DATABASE_URL=
SESSION_SECRET=change-me-to-a-long-random-string
# Load demo users and topics into an empty database (true/false)
SEED_DEMO=true
# Show one-click demo sign-in buttons on the login page (turn off for real use)
DEMO_LOGINS=true
MAX_UPLOAD_MB=10

# ---- AI research agents (all optional; agents still find real sources without them) ----
# Free Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Add more than one AI key: if one is busy or over its free limit, agents switch to the next.
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Or any other OpenAI-compatible service:
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# Free OpenAlex key raises the daily search budget: https://openalex.org/settings/api
OPENALEX_API_KEY=
# Optional Semantic Scholar key (private rate limit): https://www.semanticscholar.org/product/api
S2_API_KEY=
# Longest an agent may run before it is stopped (minutes)
# AGENT_MAX_MINUTES=12
# ---- Showcase website ----
SHOWCASE_NAME=CTENT Research
# SHOWCASE_TAGLINE=Research papers from the CTENT research group
# SHOWCASE_CONTACT=research@example.org
# Shown to OpenAlex and Wikipedia so they can contact you about heavy use
CONTACT_EMAIL=
# How many agents run at once (keep low on free AI tiers)
AGENT_CONCURRENCY=2
