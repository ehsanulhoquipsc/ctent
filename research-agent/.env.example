# Copy this file to .env and fill in what you have. Everything is free; all keys are optional.

# AI model (recommended). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Or run a model on your own computer instead (no key, no limits): install https://ollama.com, then
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b

# OpenAlex (250M+ papers). Free key, required since Feb 2026: https://openalex.org/settings/api
OPENALEX_API_KEY=
# CORE open-access full text. Free key: https://core.ac.uk/services/api
CORE_API_KEY=
# Semantic Scholar. Optional free key, reduces rate-limit errors: https://www.semanticscholar.org/product/api
S2_API_KEY=

# Your email: needed for Unpaywall (finds free full-text PDFs); CrossRef and PubMed also give faster service
CONTACT_EMAIL=

# Where the "Back to CTENT" link in the sidebar goes
CTENT_URL=https://ctent.onrender.com
